SHOWFZU_APP_NAME=ShowFZU API
SHOWFZU_ENV=development
SHOWFZU_DATABASE_URL=sqlite:///./showfzu.dev.db
SHOWFZU_SESSION_SECRET=<local-session-secret>
SHOWFZU_SESSION_COOKIE_NAME=showfzu_session
SHOWFZU_SESSION_MAX_AGE_SECONDS=604800
SHOWFZU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SHOWFZU_PUBLIC_BASE_URL=http://127.0.0.1:5173
SHOWFZU_SUPABASE_URL=<your-supabase-project-url>
SHOWFZU_SUPABASE_SERVICE_KEY=<backend-only-supabase-service-role-or-secret-key>
SHOWFZU_STORAGE_POSTS_BUCKET=post-media
SHOWFZU_STORAGE_AVATARS_BUCKET=avatars
SHOWFZU_STORAGE_GUIDE_BUCKET=official-guide
SHOWFZU_FFMPEG_PATH=ffmpeg
SHOWFZU_FFPROBE_PATH=ffprobe
SHOWFZU_SECURE_COOKIES=false

# Render production values use the same variable names:
# SHOWFZU_ENV=production
# SHOWFZU_DATABASE_URL=<supabase-postgres-direct-connection-url>
# SHOWFZU_SESSION_SECRET=<strong-random-session-secret>
# SHOWFZU_CORS_ORIGINS=<your-netlify-site-origin>
# SHOWFZU_PUBLIC_BASE_URL=<your-netlify-site-origin>
# SHOWFZU_SUPABASE_URL=<your-supabase-project-url>
# SHOWFZU_SUPABASE_SERVICE_KEY=<backend-only-supabase-service-role-or-secret-key>
# SHOWFZU_SECURE_COOKIES=true
